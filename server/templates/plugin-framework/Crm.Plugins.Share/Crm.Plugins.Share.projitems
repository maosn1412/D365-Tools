    <Compile Include="$(MSBuildThisFileDirectory)Common\Dto\ResponseResult.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Ensure.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Enums.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\CollectExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\CrmSDKCommon.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\CrmSDKExtension.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\DateTimeExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\DecimalExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\DictionaryExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\EntityExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\ExceptionExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\HashSetExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\IntExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\JsonExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\OrganizationServiceExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\StringBuilderExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\Extensions\StringExtensions.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\HashHelper.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\IRestClient.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\PluginBase.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\PluginMessage.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Common\RestClient.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Domain\EnvironmentVariableValue\EnvironmentService.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Domain\UserSetting\UserSettingQueryService.cs" />
